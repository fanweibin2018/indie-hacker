---
import { NEWSLETTER } from '@/config/site';
import { useTranslations, type Lang } from '@/i18n/ui';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const action = NEWSLETTER.buttondownUser
  ? `https://buttondown.email/api/emails/embed-subscribe/${NEWSLETTER.buttondownUser}`
  : '';
const placeholder = lang === 'zh' ? 'you@example.com' : 'you@example.com';
---
{action && (
  <form action={action} method="post" target="_blank" class="subform" novalidate>
    <input type="email" name="email" required placeholder={placeholder} aria-label="email" />
    <button class="btn btn--primary" type="submit">{t('newsletter.cta')}</button>
  </form>
)}
