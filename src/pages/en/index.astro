---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import ResourceCard from '@/components/ResourceCard.astro';
import NewsletterForm from '@/components/NewsletterForm.astro';
import { PHASES } from '@/lib/phases';
import { getLocalizedPath } from '@/i18n/ui';
import { getCollection } from 'astro:content';
import { filterArticles, sortByDateDesc } from '@/lib/collections';

const lang = 'en' as const;
const slugOf = (id: string) => id.split('/').pop()!;

// Articles
const allArticles = await getCollection('articles');
const langArticles = sortByDateDesc(filterArticles(allArticles as any, { lang })) as any[];
const featuredArticles = langArticles.slice(0, 4);

// Resources
const allResources = await getCollection('resources');
const featuredRes = (allResources as any[])
  .filter((r) => r.data.lang === lang && r.data.featured)
  .slice(0, 3);

// Per-phase counts
const phaseStats = PHASES.map((p, i) => ({
  id: p.id,
  label: p.label[lang],
  no: String(i + 1).padStart(2, '0'),
  articleCount: (allArticles as any[]).filter(
    (a) => a.data.lang === lang && a.data.phase === p.id && !a.data.draft
  ).length,
  resourceCount: (allResources as any[]).filter(
    (r) => r.data.lang === lang && r.data.phase === p.id
  ).length,
}));

const totalArticles = phaseStats.reduce((s, p) => s + p.articleCount, 0);
const totalResources = phaseStats.reduce((s, p) => s + p.resourceCount, 0);
---
<BaseLayout title="Indie Hacker Field Manual" description="A bilingual knowledge base for indie hackers, organized by the five phases of shipping.">

  <!-- ============ MASTHEAD ============ -->
  <section class="wrap masthead">
    <div class="masthead__rule">
      <span class="eyebrow">Field Manual for Indie Hackers</span>
      <span class="eyebrow">{totalArticles} articles · {totalResources} tools</span>
    </div>
    <div class="masthead__head">
      <h1>From idea to revenue, <em>every step</em> already mapped.</h1>
      <div class="masthead__aside">
        <p class="lead">
          A bilingual knowledge base built around the five phases of shipping a product — original guides cross-linked to the exact tools they mention.
        </p>
        <div style="display:flex; gap:var(--space-xs); flex-wrap:wrap;">
          <a class="btn btn--primary" href={getLocalizedPath('/discover/', lang)}>Start with Discover</a>
          <a class="btn btn--ghost" href="#resources">Browse tools</a>
        </div>
      </div>
    </div>

    <!-- Phase index strip -->
    <nav class="pindex" role="navigation" aria-label="Phase index">
      {phaseStats.map((ps) => (
        <a href={getLocalizedPath(`/${ps.id}/`, lang)} data-phase={ps.id}>
          <span class="pindex__no">{ps.no}</span>
          <span class="pindex__nm">{ps.label}</span>
          <span class="pindex__ct">{ps.articleCount} articles · {ps.resourceCount} tools</span>
        </a>
      ))}
    </nav>
  </section>

  <!-- ============ LEAD + SIDEBAR ============ -->
  <section class="wrap section" style="padding-top: clamp(2rem,1rem+3vw,3.5rem);">
    <div class="lead-grid">

      <!-- Left: featured articles grid -->
      <div class="stack" style="gap: var(--space-xl);">

        {featuredArticles.length > 0 && (
          <div>
            <div class="col-head">
              <h2>Latest articles</h2>
              <a class="link-arrow" href={getLocalizedPath('/discover/', lang)}>All<span class="ar">→</span></a>
            </div>
            <div class="grid-2">
              {featuredArticles.map((a) => (
                <ArticleCard
                  slug={slugOf(a.id)}
                  title={a.data.title}
                  description={a.data.description}
                  phase={a.data.phase}
                  lang={lang}
                  pubDate={a.data.pubDate}
                />
              ))}
            </div>
          </div>
        )}

      </div>

      <!-- Right: featured resources + subscribe -->
      <aside class="stack" id="resources">
        {featuredRes.length > 0 && (
          <div>
            <div class="col-head">
              <h2>Fresh tools</h2>
              <a class="link-arrow" href={getLocalizedPath('/discover/', lang)}>Catalog<span class="ar">→</span></a>
            </div>
            <div class="reslist">
              {featuredRes.map((r) => (
                <ResourceCard
                  name={r.data.name}
                  url={r.data.url}
                  description={r.data.description}
                  phase={r.data.phase}
                  pricing={r.data.pricing}
                  category={r.data.category}
                  tags={r.data.tags}
                  lang={lang}
                />
              ))}
            </div>
          </div>
        )}

        <!-- Mini subscribe block -->
        <div class="subscribe" style="padding: var(--space-lg); border-radius: var(--r-lg);">
          <div class="subscribe__hue"></div>
          <span class="eyebrow" style="color: color-mix(in oklch, var(--bg) 70%, transparent);">Weekly digest</span>
          <h2 style="font-size: var(--fs-h4);">One email. Five phases.</h2>
          <NewsletterForm lang={lang} />
          <span class="subform__note">Builders · no spam</span>
        </div>
      </aside>
    </div>
  </section>

  <!-- ============ SUBSCRIBE ============ -->
  <section class="wrap section" style="padding-top: 0;">
    <div class="subscribe reveal">
      <div class="subscribe__hue"></div>
      <span class="eyebrow" style="color: color-mix(in oklch, var(--bg) 70%, transparent);">Newsletter</span>
      <h2>Field notes, every Tuesday.</h2>
      <p>One curated article and one tool worth your time, across all five phases. Written by builders who shipped, not marketers.</p>
      <NewsletterForm lang={lang} />
      <span class="subform__note">Indie hackers · unsubscribe anytime</span>
    </div>
  </section>

</BaseLayout>
