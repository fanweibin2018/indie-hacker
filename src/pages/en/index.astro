---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import ResourceCard from '@/components/ResourceCard.astro';
import NewsletterForm from '@/components/NewsletterForm.astro';
import { PHASES, getPhase } from '@/lib/phases';
import { getLocalizedPath } from '@/i18n/ui';
import { NEWSLETTER } from '@/config/site';
import { getCollection } from 'astro:content';
import { filterArticles, sortByDateDesc } from '@/lib/collections';
import { readingLabel } from '@/lib/reading-time';

const lang = 'en' as const;
const slugOf = (id: string) => id.split('/').pop()!;
const shortDate = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;

// Articles
const allArticles = await getCollection('articles');
const langArticles = sortByDateDesc(filterArticles(allArticles as any, { lang })) as any[];
const feature = langArticles[0];
const latestArticles = langArticles.slice(1, 5);
// Dense ledger: recent cross-linked articles (re-uses the sorted set as a distinct lens)
const ledgerArticles = langArticles.slice(0, 5);

// Resources
const allResources = await getCollection('resources');
const featuredRes = (allResources as any[])
  .filter((r) => r.data.lang === lang && r.data.featured)
  .slice(0, 3);

// Per-phase counts
const phaseStats = PHASES.map((p, i) => ({
  id: p.id,
  label: p.label[lang],
  no: String(i + 1).padStart(2, '0'),
  articleCount: (allArticles as any[]).filter(
    (a) => a.data.lang === lang && a.data.phase === p.id && !a.data.draft
  ).length,
  resourceCount: (allResources as any[]).filter(
    (r) => r.data.lang === lang && r.data.phase === p.id
  ).length,
}));

const totalArticles = phaseStats.reduce((s, p) => s + p.articleCount, 0);
const totalResources = phaseStats.reduce((s, p) => s + p.resourceCount, 0);
---
<BaseLayout title="Indie Hacker Field Manual" description="A bilingual knowledge base for indie hackers, organized by the five phases of shipping.">

  <!-- ============ MASTHEAD ============ -->
  <section class="wrap masthead">
    <div class="masthead__rule">
      <span class="eyebrow">Field Manual for Indie Hackers</span>
      <span class="eyebrow">{totalArticles} articles · {totalResources} tools</span>
    </div>
    <div class="masthead__head">
      <h1>From idea to revenue, <em>every step</em> already mapped.</h1>
      <div class="masthead__aside">
        <p class="lead">
          A bilingual knowledge base built around the five phases of shipping a product — original guides cross-linked to the exact tools they mention.
        </p>
        <div style="display:flex; gap:var(--space-xs); flex-wrap:wrap;">
          <a class="btn btn--primary" href={getLocalizedPath('/discover/', lang)}>Start with Discover</a>
          <a class="btn btn--ghost" href="#resources">Browse tools</a>
        </div>
      </div>
    </div>

    <!-- Phase index strip -->
    <nav class="pindex" role="navigation" aria-label="Phase index">
      {phaseStats.map((ps) => (
        <a href={getLocalizedPath(`/${ps.id}/`, lang)} data-phase={ps.id}>
          <span class="pindex__no">{ps.no}</span>
          <span class="pindex__nm">{ps.label}</span>
          <span class="pindex__ct">{ps.articleCount} articles · {ps.resourceCount} tools</span>
        </a>
      ))}
    </nav>
  </section>

  <!-- ============ LEAD + SIDEBAR ============ -->
  <section class="wrap section" style="padding-top: clamp(2rem,1rem+3vw,3.5rem);">
    <div class="lead-grid">

      <!-- Left: feature article + latest grid -->
      <div class="stack" style="gap: var(--space-xl);">

        {feature && (
          <article class="acard acard--feature reveal" data-phase={feature.data.phase}>
            <div class="acard__media ph" data-phase={feature.data.phase}></div>
            <div class="acard__body">
              <div class="acard__meta">
                <a class="chip" data-phase={feature.data.phase} href={getLocalizedPath(`/${feature.data.phase}/`, lang)}>
                  <span class="dot"></span>{getPhase(feature.data.phase).label[lang]}
                </a>
                <span class="mono muted">{readingLabel(feature.body)}</span>
              </div>
              <h3 class="acard__title">
                <a href={getLocalizedPath(`/articles/${slugOf(feature.id)}/`, lang)}>{feature.data.title}</a>
              </h3>
              <p class="acard__dek">{feature.data.description}</p>
              <div class="acard__foot"><span>{shortDate(feature.data.pubDate)}</span></div>
            </div>
          </article>
        )}

        {latestArticles.length > 0 && (
          <div>
            <div class="col-head">
              <h2>Latest articles</h2>
              <a class="link-arrow" href={getLocalizedPath('/discover/', lang)}>All<span class="ar">→</span></a>
            </div>
            <div class="grid-2">
              {latestArticles.map((a) => (
                <ArticleCard
                  slug={slugOf(a.id)}
                  title={a.data.title}
                  description={a.data.description}
                  phase={a.data.phase}
                  lang={lang}
                  pubDate={a.data.pubDate}
                  readingTime={readingLabel(a.body)}
                />
              ))}
            </div>
          </div>
        )}

      </div>

      <!-- Right: featured resources + subscribe -->
      <aside class="stack" id="resources">
        {featuredRes.length > 0 && (
          <div>
            <div class="col-head">
              <h2>Fresh tools</h2>
              <a class="link-arrow" href={getLocalizedPath('/discover/', lang)}>Catalog<span class="ar">→</span></a>
            </div>
            <div class="reslist">
              {featuredRes.map((r) => (
                <ResourceCard
                  name={r.data.name}
                  url={r.data.url}
                  description={r.data.description}
                  phase={r.data.phase}
                  pricing={r.data.pricing}
                  category={r.data.category}
                  tags={r.data.tags}
                  lang={lang}
                />
              ))}
            </div>
          </div>
        )}

        <!-- Mini subscribe block -->
        {NEWSLETTER.buttondownUser && (
          <div class="subscribe" style="padding: var(--space-lg); border-radius: var(--r-lg);">
            <div class="subscribe__hue"></div>
            <span class="eyebrow" style="color: color-mix(in oklch, var(--bg) 70%, transparent);">Weekly digest</span>
            <h2 style="font-size: var(--fs-h4);">One email. Five phases.</h2>
            <NewsletterForm lang={lang} />
            <span class="subform__note">Builders · no spam</span>
          </div>
        )}
      </aside>
    </div>
  </section>

  <!-- ============ FIELD NOTES (dense ledger) ============ -->
  {ledgerArticles.length > 0 && (
    <section class="field-band">
      <div class="wrap section" style="padding-block: clamp(2rem,1.4rem+3vw,4rem);">
        <div class="section-head">
          <div>
            <span class="eyebrow">From the field</span>
            <h2>Recently cross-linked</h2>
          </div>
          <a class="link-arrow" href={getLocalizedPath('/discover/', lang)}>Full index<span class="ar">→</span></a>
        </div>
        <div>
          {ledgerArticles.map((a, i) => (
            <a
              class="arow"
              data-phase={a.data.phase}
              href={getLocalizedPath(`/articles/${slugOf(a.id)}/`, lang)}
              style={i === ledgerArticles.length - 1 ? 'border-bottom:0;' : undefined}
            >
              <span class="arow__idx">{String(i + 1).padStart(2, '0')}</span>
              <span class="arow__title">{a.data.title}</span>
              <span class="arow__meta">
                <span class="chip" data-phase={a.data.phase}><span class="dot"></span>{getPhase(a.data.phase).label[lang]}</span>
                {' · '}{readingLabel(a.body)}
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ============ SUBSCRIBE ============ -->
  {NEWSLETTER.buttondownUser && (
    <section class="wrap section" style="padding-top: 0;">
      <div class="subscribe reveal">
        <div class="subscribe__hue"></div>
        <span class="eyebrow" style="color: color-mix(in oklch, var(--bg) 70%, transparent);">Newsletter</span>
        <h2>Field notes, every Tuesday.</h2>
        <p>One curated article and one tool worth your time, across all five phases. Written by builders who shipped, not marketers.</p>
        <NewsletterForm lang={lang} />
        <span class="subform__note">Indie hackers · unsubscribe anytime</span>
      </div>
    </section>
  )}

</BaseLayout>
