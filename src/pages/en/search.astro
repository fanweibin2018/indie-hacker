---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
---
<BaseLayout title="Search" description="Search every article and tool in the catalog">
  <PageHeader
    lang="en"
    eyebrow="Site search"
    title="Search"
    lead="Search every article and every tool by name, tag or description."
    meta="⌘K from anywhere"
  />

  <section class="wrap section" style="padding-top: clamp(1.5rem,1rem+2vw,2.5rem);">
    <div class="search-hero">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.2-3.2"/></svg>
      <input id="site-search-input" type="search" placeholder="Search articles, tools, tags…" aria-label="Search" autocomplete="off" spellcheck="false" />
    </div>
    <div id="site-search-list" class="results" data-lang="en">
      <p class="palette__empty">Type a keyword to search every article and tool.</p>
    </div>
    <noscript>
      <p class="muted" style="font-family: var(--font-mono); font-size: var(--fs-small);">Search requires JavaScript.</p>
    </noscript>
  </section>
</BaseLayout>
