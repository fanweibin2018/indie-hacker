---
import BaseLayout from '@/layouts/BaseLayout.astro';
---
<BaseLayout title="Search" description="Site search">
  <h1>Search</h1>
  <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  <div id="search"></div>
  <script is:inline>
    // pagefind is generated after build
    // pagefind-ui.js is an IIFE that attaches window.PagefindUI (no named export)
    window.addEventListener('DOMContentLoaded', async () => {
      await import('/pagefind/pagefind-ui.js');
      new window.PagefindUI({ element: '#search', showSubResults: true });
    });
  </script>
</BaseLayout>
