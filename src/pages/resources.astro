---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ResourceCard from '@/components/ResourceCard.astro';
import ResourceFilter from '@/components/ResourceFilter.astro';
import PageHeader from '@/components/PageHeader.astro';
import { getCollection } from 'astro:content';

const lang = 'zh' as const;

const all = await getCollection('resources');
const resources = (all as any[]).filter((r) => r.data.lang === lang);
const resourceCategories = resources.map((r) => r.data.category as string);
---
<BaseLayout title="资源目录" description="跨阶段的独立开发者工具与资源">

  <PageHeader
    lang="zh"
    eyebrow="工具目录"
    title="资源目录"
    lead="精选独立开发者工具，跨五个阶段，按阶段、分类与定价实时筛选。"
    meta={`${resources.length} 个工具`}
  />

  <section class="catalog" style="margin-top: clamp(2rem,1.4rem+3vw,3.5rem);">
    <div class="filters-wrap">
      <div class="wrap">
        <ResourceFilter lang={lang} showPhase={true} categories={resourceCategories} />
      </div>
    </div>
    <div class="wrap" style="padding-bottom: clamp(2rem,1.4rem+3vw,4rem);">
      <div class="resgrid" id="resgrid">
        {resources.map((r) => (
          <ResourceCard
            name={r.data.name}
            url={r.data.url}
            description={r.data.description}
            phase={r.data.phase}
            pricing={r.data.pricing}
            category={r.data.category}
            tags={r.data.tags}
            lang={lang}
          />
        ))}
        <div class="empty" id="resempty">没有符合筛选条件的工具，试着清除一个条件。</div>
      </div>
    </div>
  </section>

</BaseLayout>
